{
  "name": "react-vite-tailwind",
  "private": true,
  "version": "2.8.7",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/preflight-build.mjs && vite build",
    "preview": "vite preview",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "ai-battle": "esbuild src/ai/battleCli.ts --bundle --platform=node --format=cjs --outfile=.ai-battle/ai-battle.cjs && node .ai-battle/ai-battle.cjs",
    "ai-arena": "esbuild src/ai/arenaCli.ts --bundle --platform=node --format=cjs --outfile=.ai-battle/ai-arena.cjs && node .ai-battle/ai-arena.cjs"
  },
  "dependencies": {
    "@types/file-saver": "^2.0.7",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "file-saver": "^2.0.5",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tailwind-merge": "^3.4.0",
    "uuid": "^11.1.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "4.1.17",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "jsdom": "^30.1.0",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "7.3.6",
    "vite-plugin-singlefile": "2.3.0",
    "vitest": "^5.0.1"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "4.62.2"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
